# 统一国库 ConetTreasury（CREATE2 跨链同址 0xa311…3B30）
# Base(8453)：监听 BUnitPurchased → CoNET voteAirdropBUnitFromBase
BASE_TREASURY_ADDRESS=0xa311c8fBE7CafC611603Ee925465A62493B73B30
# 优先使用 Beamio Base RPC wss；vote 与 /base-rpc 转发内部转为 https
BASE_RPC=wss://base-rpc.conet.network/ws
# Base RPC HTTP：当 BASE_RPC 未设置时使用
BASE_RPC_HTTP=https://base-rpc.conet.network

# CoNET(224422)：与 Base 同 CREATE2 地址
CONET_TREASURY_ADDRESS=0xa311c8fBE7CafC611603Ee925465A62493B73B30
CONET_RPC=https://rpc1.conet.network

# ConetTreasuryPeer（CREATE2 同址 0x025e…beb5）
# Base BridgeOut → CoNET voteMintFromPeerDeposit / voteMintFromPeerCredit（仅 Treasury isMiner）
BASE_TREASURY_PEER_ADDRESS=0x025eC62F801B2f63d5C5b3eB066bab21B12Bbeb5
CONET_TREASURY_PEER_ADDRESS=0x025eC62F801B2f63d5C5b3eB066bab21B12Bbeb5

# Peer 回填 / live poll（可选；未设时回退 VOTE_BASE_*）
# VOTE_PEER_BACKFILL_BLOCKS=2000
# VOTE_PEER_LOGS_CHUNK_BLOCKS=400
# VOTE_PEER_LIVE_POLL_INTERVAL_MS=12000
# VOTE_PEER_SCAN_STATE_FILE=.vote-base-peer-bridge-scan-state.json

